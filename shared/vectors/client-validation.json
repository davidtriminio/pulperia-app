    {
      "name": "nombre válido sin nota ni otros clientes",
      "input": {
        "name": "Ana López",
        "existingNames": []
      },
      "expected": {
        "errors": [],
        "duplicate": false
      }
    },
    {
      "name": "RF-15: nombre vacío",
      "input": {
        "name": "",
        "existingNames": []
      },
      "expected": {
        "errors": [
          "name_required"
        ],
        "duplicate": false
      }
    },
