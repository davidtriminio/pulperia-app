{
  "description": "Respuestas de ejemplo de la sincronización: resultado de cada operación del lote y una página de cambios con los cuatro tipos de registro.",
  "cases": [
    {
      "name": "operación aplicada",
      "schema": "OperationResult",
      "example": { "opId": "0198a000-0000-7000-8000-0000000000a1", "status": "applied" }
    },
    {
      "name": "operación repetida: ya se había aplicado",
      "schema": "OperationResult",
      "example": { "opId": "0198a000-0000-7000-8000-0000000000a2", "status": "duplicate" }
    },
    {
      "name": "operación rechazada con su código",
      "schema": "OperationResult",
      "example": {
        "opId": "0198a000-0000-7000-8000-0000000000a3",
        "status": "rejected",
        "code": "version_conflict",
        "codes": ["version_conflict"]
      }
    },
    {
      "name": "operación rechazada por varios motivos",
      "schema": "OperationResult",
      "example": {
        "opId": "0198a000-0000-7000-8000-0000000000a4",
        "status": "rejected",
        "code": "amount_too_large",
        "codes": ["amount_too_large", "quantity_too_large"]
      }
    },
    {
      "name": "lote con una aplicada, una repetida y una rechazada",
      "schema": "PushResponse",
      "example": {
        "results": [
          { "opId": "0198a000-0000-7000-8000-0000000000a1", "status": "applied" },
          { "opId": "0198a000-0000-7000-8000-0000000000a2", "status": "duplicate" },
          {
            "opId": "0198a000-0000-7000-8000-0000000000a3",
            "status": "rejected",
            "code": "client_not_found",
            "codes": ["client_not_found"]
          }
        ]
      }
    },
    {
      "name": "página de cambios vacía: el cursor se queda donde estaba",
      "schema": "PullResponse",
      "example": { "cursor": 7, "hasMore": false, "changes": [] }
    },
    {
      "name": "página con un cliente, un producto con precio anterior, un fiado anulado con ítems y un abono",
      "schema": "PullResponse",
      "example": {
        "cursor": 12,
        "hasMore": true,
        "changes": [
          {
            "seq": 8,
            "type": "client",
            "entity": {
