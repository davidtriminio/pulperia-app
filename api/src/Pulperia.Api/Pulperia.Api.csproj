<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Secretos de desarrollo fuera del repositorio: dotnet user-secrets set ... -->
    <UserSecretsId>pulperia-api-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pulperia.Application\Pulperia.Application.csproj" />
    <ProjectReference Include="..\Pulperia.Infrastructure\Pulperia.Infrastructure.csproj" />
  </ItemGroup>

</Project>
