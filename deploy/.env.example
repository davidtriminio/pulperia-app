# Copia este archivo como `.env` (junto a docker-compose.yml) y completa los valores.
# El `.env` real NO va al repositorio (ver .gitignore).

# Dominio de la API, apuntado a la IP pública de la máquina (registro A, sin proxy de Cloudflare).
# Caddy saca solo el certificado de Let's Encrypt para este nombre.
API_DOMAIN=api.ejemplo.com

# Base de datos. Usa una contraseña larga y propia.
POSTGRES_USER=pulperia
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=pulperia

# Orígenes del navegador que pueden llamar a la API, separados por comas: la URL de la web en
# Vercel. Vacío = ninguno. No uses `*`.
CORS_ALLOWED_ORIGINS=https://pulperia-web.vercel.app

# Copia diaria de la base (ver deploy/README.md).
BACKUP_AT=03:00
BACKUP_KEEP=3
# Carpeta del servidor donde quedan las copias (por omisión ./backups, junto al Compose).
# BACKUPS_DIR=./backups
# Opcional: comando que se ejecuta tras cada copia con la ruta en $BACKUP_FILE, para enviarla
# fuera del servidor. Vacío = solo queda en ./backups.
BACKUP_AFTER_COMMAND=
